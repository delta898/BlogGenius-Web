# Development Backoffice runtime values (TEMPLATE - copy, do not edit in place).
#
#   cp deployment/env/development.env.example deployment/env/development.env
#   # fill SUPABASE_URL and SUPABASE_ANON_KEY from the Development Supabase
#   # Dashboard (Project Settings -> API), then:
#   chmod 600 deployment/env/development.env
#
# This file is the single source on the operator machine:
# - `./ops admin-dev` reads it for local runs against Development Supabase.
# - `./ops deploy development` checks it and uploads it to the host on every
#   deploy, so the host copy never drifts.
# It must contain ONLY the keys below (manifest keys would shadow releases).
SUPABASE_URL=https://<dev-ref>.supabase.co
SUPABASE_ANON_KEY=<dev-anon-key>
