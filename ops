#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
compose_file="$project_root/deployment/compose.local.yml"
oracle_compose_file="$project_root/deployment/compose.oracle.yml"
manifest_tool="$project_root/scripts/release-manifest.mjs"
target_platform="linux/amd64"

usage() {
  cat <<'EOF'
Usage: ./ops <command>

Local foundation commands:
  help       Show this help.
  doctor     Check required local tools and target architecture.
  validate   Run lint, type checks, unit tests and application builds.
  build      Build the local linux/amd64 site and admin images.
  up         Build and start the local Compose project, then wait for health.
  down       Stop the local Compose project without deleting volumes.
  status     Show Git identity and local container status.
  admin-dev  Run Backoffice dev server against Development Supabase
             (reads apps/admin/.env.local; never use for Production).

Deployment foundation commands:
  manifest verify <file> <environment>
             Verify the immutable release manifest contract.
  preflight development <file> [--check-only]
             Verify a Development manifest and render Oracle Compose safely.
  deploy development [<file>]
             Deploy a verified Development manifest to the Oracle server.
             Without <file>, use the manifest from the successful publish
             run for the current commit.
  rollback development
             Roll back to the previous Development release on the Oracle server.

Production deployment commands remain unavailable until the Production
promotion process is defined and approved.
EOF
}

require_command() {
  local command_name="$1"
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Required command not found: $command_name" >&2
    exit 1
  fi
}

run_doctor() {
  local node_version node_major

  for command_name in git node pnpm docker; do
    require_command "$command_name"
  done

  node_version="$(node --version)"
  node_major="${node_version#v}"
  node_major="${node_major%%.*}"
  if [[ "$node_major" != "24" ]]; then
    echo "Node.js 24 is required; found $node_version." >&2
    exit 1
  fi

  docker compose version >/dev/null

  echo "Repository: $project_root"
  echo "Node:       $node_version"
  echo "pnpm:       $(pnpm --version)"
  echo "Docker:     $(docker --version)"
  if docker info >/dev/null 2>&1; then
    echo "Daemon:     running"
  else
    echo "Daemon:     not running (required only for build/up/status)"
  fi
  echo "Host arch:  $(uname -m)"
  echo "Target:     $target_platform"
}

require_docker_daemon() {
  if ! docker info >/dev/null 2>&1; then
    echo "Docker daemon is not running. Start Docker before this command." >&2
    exit 1
  fi
}

run_validate() {
  run_doctor
  cd "$project_root"
  pnpm lint
  pnpm typecheck
  pnpm test
  pnpm build
}

run_build() {
  run_doctor
  require_docker_daemon
  docker compose --file "$compose_file" build
}

run_up() {
  run_doctor
  require_docker_daemon
  docker compose --file "$compose_file" up --detach --build --wait
}

run_down() {
  require_command docker
  require_docker_daemon
  docker compose --file "$compose_file" down
}

run_status() {
  local branch sha dirty

  branch="$(git -C "$project_root" branch --show-current)"
  sha="$(git -C "$project_root" rev-parse --short=12 HEAD)"
  if [[ -n "$(git -C "$project_root" status --short)" ]]; then
    dirty="yes"
  else
    dirty="no"
  fi

  echo "Branch:     $branch"
  echo "Commit:     $sha"
  echo "Dirty:      $dirty"
  echo "Target:     $target_platform"
  require_docker_daemon
  docker compose --file "$compose_file" ps
}

run_manifest() {
  local action="${1:-}" manifest_file="${2:-}" environment="${3:-}"

  require_command node
  if [[ "$action" != "verify" || -z "$manifest_file" || -z "$environment" ]]; then
    echo "Usage: ./ops manifest verify <file> <environment>" >&2
    exit 2
  fi
  node "$manifest_tool" verify "$manifest_file" "$environment"
}

run_preflight() {
  local environment="${1:-}" manifest_file="${2:-}" mode="${3:-}"
  local branch head manifest_sha

  if [[ "$environment" != "development" || -z "$manifest_file" ]]; then
    echo "Usage: ./ops preflight development <file> [--check-only]" >&2
    exit 2
  fi
  if [[ -n "$mode" && "$mode" != "--check-only" ]]; then
    echo "Unknown preflight option: $mode" >&2
    exit 2
  fi

  require_command git
  require_command node
  require_command docker
  node "$manifest_tool" verify "$manifest_file" "$environment"
  # Compose render check only: Supabase values are dummies here.
  # Real values come from the host env file at deploy time.
  SUPABASE_URL="https://preflight.invalid" SUPABASE_ANON_KEY="preflight" \
    docker compose --env-file "$manifest_file" --file "$oracle_compose_file" config --quiet

  branch="$(git -C "$project_root" branch --show-current)"
  head="$(git -C "$project_root" rev-parse HEAD)"
  manifest_sha="$(sed -n 's/^RELEASE_SHA=//p' "$manifest_file")"

  if [[ "$mode" == "--check-only" ]]; then
    echo "Compose contract is valid (check-only; branch/SHA eligibility skipped)."
    return
  fi
  if [[ "$branch" != "dev" ]]; then
    echo "Development deployment eligibility requires branch dev; found $branch." >&2
    exit 1
  fi
  if [[ -n "$(git -C "$project_root" status --short)" ]]; then
    echo "Development deployment eligibility requires a clean working tree." >&2
    exit 1
  fi
  if [[ "$manifest_sha" != "$head" ]]; then
    echo "Manifest RELEASE_SHA does not match the current commit." >&2
    exit 1
  fi

  echo "Development release is eligible for ./ops deploy development."
}

resolve_manifest() {
  local head_sha="$1" run_id tmp_dir

  require_command gh
  run_id="$(gh run list --branch dev --workflow "Publish Development Images" \
    --limit 10 --json databaseId,headSha,conclusion \
    -q "[.[] | select(.headSha==\"$head_sha\" and .conclusion==\"success\")][0].databaseId")"
  if [[ -z "$run_id" || "$run_id" == "null" ]]; then
    echo "No successful publish run found for commit $head_sha." >&2
    echo "Wait for CI on dev, or pass a manifest file explicitly." >&2
    exit 1
  fi
  tmp_dir="$(mktemp -d)"
  gh run download "$run_id" -n "development-release-$head_sha" --dir "$tmp_dir"
  echo "$tmp_dir/development.release.env"
}

run_deploy() {
  local environment="${1:-}" manifest_file="${2:-}"
  local manifest_sha remote_dir
  local deploy_host="${DEPLOY_HOST:-oracle1}"
  local deploy_root="${DEPLOY_ROOT:-/home/ubuntu/Project/BlogGenius-Web}"

  if [[ "$environment" != "development" ]]; then
    echo "Usage: ./ops deploy development [<file>]" >&2
    exit 2
  fi

  require_command git
  require_command node
  require_command docker
  require_command ssh
  require_command scp
  if [[ -z "$manifest_file" ]]; then
    manifest_file="$(resolve_manifest "$(git -C "$project_root" rev-parse HEAD)")"
    echo "Using manifest from the successful publish run:"
    echo "  $manifest_file"
  fi
  run_preflight "$environment" "$manifest_file"

  manifest_sha="$(sed -n 's/^RELEASE_SHA=//p' "$manifest_file")"
  remote_dir="$deploy_root/releases/$manifest_sha"
  # Host env file holds per-environment runtime values (SUPABASE_URL,
  # SUPABASE_ANON_KEY). The local deployment/env/<environment>.env is the
  # single source; it is uploaded on every deploy so the host never drifts.
  # It must not redefine manifest keys. Never committed (see .gitignore).
  local_env_file="$project_root/deployment/env/$environment.env"
  remote_env_file="$deploy_root/env/$environment.env"
  if [[ ! -f "$local_env_file" ]]; then
    echo "Missing $local_env_file." >&2
    echo "Copy deployment/env/development.env.example and fill the values." >&2
    exit 1
  fi
  check_env_file_keys "$local_env_file"

  ssh "$deploy_host" "mkdir -p '$remote_dir' '$deploy_root/env'"
  scp "$oracle_compose_file" "$deploy_host:$remote_dir/compose.oracle.yml"
  scp "$manifest_file" "$deploy_host:$remote_dir/release.env"
  scp "$local_env_file" "$deploy_host:$remote_env_file"
  ssh "$deploy_host" "\
    cd '$remote_dir' && \
    docker compose --env-file release.env --env-file '$remote_env_file' -f compose.oracle.yml config --quiet && \
    docker compose --env-file release.env --env-file '$remote_env_file' -f compose.oracle.yml pull && \
    docker compose --env-file release.env --env-file '$remote_env_file' -f compose.oracle.yml up --detach --wait --wait-timeout 180"
  ssh "$deploy_host" "\
    cd '$deploy_root' && \
    if [ -L current ]; then \
      ln -sfn \"\$(readlink current)\" previous; \
    fi && \
    ln -sfn 'releases/$manifest_sha' current"

  echo "Deployed development release $manifest_sha."
  echo "Next: verify with ./ops preflight output above and the OracleWebInfra cutover check."
}

run_rollback() {
  local environment="${1:-}"
  local deploy_host="${DEPLOY_HOST:-oracle1}"
  local deploy_root="${DEPLOY_ROOT:-/home/ubuntu/Project/BlogGenius-Web}"

  if [[ "$environment" != "development" ]]; then
    echo "Usage: ./ops rollback development" >&2
    exit 2
  fi

  require_command ssh
  ssh "$deploy_host" "\
    cd '$deploy_root' && \
    if [ ! -L previous ]; then \
      echo 'No previous Development release is available.' >&2; \
      exit 1; \
    fi && \
    previous_target=\"\$(readlink previous)\" && \
    current_target=\"\$(readlink current)\" && \
    cd \"\$previous_target\" && \
    docker compose --env-file release.env --env-file '$deploy_root/env/$environment.env' -f compose.oracle.yml up --detach --wait --wait-timeout 180 && \
    cd '$deploy_root' && \
    ln -sfn \"\$current_target\" previous && \
    ln -sfn \"\$previous_target\" current && \
    echo \"Rolled back to \$previous_target.\""

  echo "Development rollback finished. Verify application health and routes."
}

run_admin_dev() {
  local env_file="$project_root/deployment/env/development.env"

  require_command pnpm
  if [[ ! -f "$env_file" ]]; then
    echo "Missing $env_file." >&2
    echo "Copy deployment/env/development.env.example and fill SUPABASE_URL / SUPABASE_ANON_KEY." >&2
    exit 1
  fi
  if grep -q "PRODUCTION\|production" "$env_file"; then
    echo "Refusing: $env_file looks like Production config." >&2
    exit 1
  fi
  check_env_file_keys "$env_file"
  cd "$project_root"
  set -a
  # shellcheck disable=SC1090
  source "$env_file"
  set +a
  APP_ENVIRONMENT=development pnpm --filter @bloggenius/admin run dev:development
}

# Shared guard: env file must carry exactly the runtime keys, nothing else.
check_env_file_keys() {
  local env_file="$1" key
  local missing=""

  for key in SUPABASE_URL SUPABASE_ANON_KEY; do
    if ! grep -q "^${key}=[^[:space:]]" "$env_file"; then
      missing="$missing $key"
    fi
  done
  if [[ -n "$missing" ]]; then
    echo "Missing keys in $env_file: $missing" >&2
    exit 1
  fi
  if grep -q -E "^(RELEASE_|DEPLOY_ENVIRONMENT|SITE_IMAGE|ADMIN_IMAGE)" "$env_file"; then
    echo "Refusing: $env_file must not redefine manifest keys." >&2
    exit 1
  fi
}

command_name="${1:-help}"
case "$command_name" in
  help|-h|--help)
    usage
    ;;
  doctor)
    run_doctor
    ;;
  validate)
    run_validate
    ;;
  build)
    run_build
    ;;
  up)
    run_up
    ;;
  down)
    run_down
    ;;
  status)
    run_status
    ;;
  admin-dev)
    run_admin_dev
    ;;
  manifest)
    shift
    run_manifest "$@"
    ;;
  preflight)
    shift
    run_preflight "$@"
    ;;
  deploy)
    shift
    run_deploy "$@"
    ;;
  rollback)
    shift
    run_rollback "$@"
    ;;
  *)
    echo "Unknown command: $command_name" >&2
    usage >&2
    exit 2
    ;;
esac
